# =========================================================================
# Ejemplo de Variables de Entorno - Grupo ASD Product Sync
# =========================================================================

# Base de Datos PostgreSQL
DB_NAME=grupoasd_db
DB_USER=grupoasd_user
DB_PASSWORD=grupoasd_pass
DB_PORT=5432

# ActiveMQ Broker
ACTIVEMQ_PORT=61616
ACTIVEMQ_CONSOLE_PORT=8161
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin

# Colas de Mensajería
QUEUE_PRODUCTOS_REGISTRO=grupoasd.productos.registro.queue
QUEUE_PRODUCTOS_NOTIFICACION=grupoasd.productos.notificacion.queue

# Configuración de Reintentos Consumidor
ACTIVEMQ_MAX_REDELIVERIES=3
ACTIVEMQ_INITIAL_REDELIVERY_DELAY=2000

# Puertos y Job Programado
PUBLISHER_PORT=8080
CONSUMER_PORT=8081
JOB_CRON_INTERVAL_MS=10000
