        <!-- ========================================================================= -->
        <!-- BOTTOM LEGEND BOX                                                         -->
        <!-- ========================================================================= -->
        <mxCell id="legend" value="&lt;b&gt;Flujo Numerado de la Arquitectura:&lt;/b&gt;&lt;br&gt;1. Cliente invoca POST /api/v1/productos  |  2. Persiste en grupoasd_dev (publicado=false, notificado=false)  |  3. Job (@Scheduled 10s) consulta pendientes  |  4. Publica en Cola 1 (registro.queue) y marca publicado=true&lt;br&gt;5. ConsumerListener lee de Cola 1  |  6. Valida y guarda en grupoasd_prod sin duplicar  |  7. Publica ACK en Cola 2 (notificacion.queue)  |  8. ConfirmacionListener marca notificado=true  |  9. Tras 3 fallos -&gt; ActiveMQ.DLQ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;fillColor=#f8fafc;strokeColor=#e2e8f0;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1">
