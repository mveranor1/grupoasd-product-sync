        <mxCell id="title" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Arquitectura de Sincronización de Productos - Grupo ASD&lt;/font&gt;&lt;br&gt;&lt;b&gt;Despliegue en 4 contenedores Docker Compose: Aplicación 1 (Origen), Broker ActiveMQ Classic, Aplicación 2 (Destino) y PostgreSQL 16&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#1e293b;" vertex="1" parent="1">
